<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->

	<bean name="emp1" class="com.learning.model.Employee">
		<property name="id" value="111" />
		<property name="name" value="Vishal" />
		<property name="gender" value="male" />
		<property name="salary" value="100091" />
	</bean>


	<bean name="emp2" class="com.learning.model.Employee">
		<constructor-arg name="id" value="112" />
		<constructor-arg name="name" value="Sarita" />
		<constructor-arg name="gender" value="Female" />
		<constructor-arg name="salary" value="100091" />
	</bean>


</beans>